{% comment %}
  Discount product card for ENARTE sale/clearance carousel.
  @param {object} product
  @param {object} variant
{% endcomment %}
{% liquid
  assign price = variant.price
  assign compare = variant.compare_at_price | default: product.compare_at_price
  assign save_pct = 0
  if compare > price and compare > 0
    assign save_pct = compare | minus: price | times: 100.0 | divided_by: compare | round
  endif
  assign image = variant.featured_image | default: product.featured_image

  assign rating = product.metafields.reviews.rating.value.rating
  assign rating_count = product.metafields.reviews.rating_count.value | default: product.metafields.reviews.rating_count
  if rating == blank and product.metafields.custom.rating != blank
    assign rating = product.metafields.custom.rating.value
    assign rating_count = product.metafields.custom.rating_count.value | default: product.metafields.custom.rating_count
  endif
  if rating == blank
    assign rating = 4.9
  endif
  if rating_count == blank
    assign rating_count = 18
  endif
  assign star_fill = rating | round
  if star_fill > 5
    assign star_fill = 5
  endif
  if star_fill < 1
    assign star_fill = 5
  endif
%}
<a class="enarte-sale-card" href="{{ product.url }}">
  {% if save_pct > 0 %}
    <span class="enarte-sale-card__badge">خصم {{ save_pct }}%</span>
  {% endif %}
  <div class="enarte-sale-card__media">
    {% if image != blank %}
      {{
        image
        | image_url: width: 800
        | image_tag:
          loading: 'lazy',
          widths: '240,320,480,640,800',
          sizes: '(min-width: 990px) 18vw, 44vw',
          alt: product.title
      }}
    {% else %}
      {{ 'product-1' | placeholder_svg_tag }}
    {% endif %}
  </div>
  <div class="enarte-sale-card__body">
    <h3 class="enarte-sale-card__title">{{ product.title }}</h3>
    <div class="enarte-sale-card__rating" aria-label="تقييم {{ rating }} من 5">
      <span class="enarte-sale-card__stars" aria-hidden="true">
        {% for i in (1..5) %}
          <svg viewBox="0 0 20 20" {% if i > star_fill %}style="opacity:0.28"{% endif %}>
            <path d="M10 1.5l2.47 5.01 5.53.8-4 3.9.94 5.5L10 14.27 5.06 16.71l.94-5.5-4-3.9 5.53-.8L10 1.5z"/>
          </svg>
        {% endfor %}
      </span>
      <span class="enarte-sale-card__count">{{ rating_count }} المراجعات</span>
    </div>
    <div class="enarte-sale-card__prices">
      <p class="enarte-sale-card__price">{{ price | money }}</p>
      {% if compare > price %}
        <p class="enarte-sale-card__compare">{{ compare | money }}</p>
      {% endif %}
    </div>
  </div>
</a>
