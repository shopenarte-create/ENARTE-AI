{% comment %}
  ENARTE AI Features — approved production layout (desktop screenshot reference).
  Desktop (≥990px): three equal cards in one row.
  Mobile/tablet: same card shell in one horizontal swipe row (~300×150, gap 16px).
{% endcomment %}
{% assign shop_q = shop.permanent_domain | url_encode %}
{% assign assistant_href = '/apps/enarte-ai/assistant?shop=' | append: shop_q | append: '&locale=ar&action=talk_to_assistant&continue=1' %}
{% assign search_href = '/apps/enarte-ai/search-by-image?shop=' | append: shop_q | append: '&locale=ar' %}

<section class="enarte-ai-features" id="enarte-ai-features">
  <div class="enarte-ai-features__inner page-width">
    {% if section.settings.heading != blank %}
      <h2 class="enarte-ai-features__heading">{{ section.settings.heading }}</h2>
    {% endif %}
    {% if section.settings.subheading != blank %}
      <p class="enarte-ai-features__sub">{{ section.settings.subheading }}</p>
    {% endif %}

    <div class="enarte-ai-features__grid">
      {% for block in section.blocks %}
        {% liquid
          assign style = block.settings.style | default: 'ai'
          assign card_title = block.settings.title | strip
          assign card_btn = block.settings.button_label | strip

          comment
            Approved copy is style-locked so a stale Theme Editor
            value cannot collapse every card to the same description.
          endcomment
          if style == 'search'
            assign card_title_default = 'ابحث بالصورة'
            assign card_text = 'ارفع صورة أي ثريا ونجد لك ما يناسبها'
            assign card_btn_default = 'ابحث الآن'
            assign asset_file = 'enarte-feature-search.jpg'
            assign flow = 'image-search'
            assign href = search_href
          elsif style == 'room'
            assign card_title_default = 'جرب الإضاءة في غرفتك'
            assign card_text = 'شاهد كيف ستبدو الإضاءة في مساحتك باستخدام الذكاء الاصطناعي'
            assign card_btn_default = 'جرب الآن'
            assign asset_file = 'enarte-feature-room.jpg'
            assign flow = 'room-try'
            assign href = '#enarte-room-try'
          else
            assign card_title_default = 'ENARTE AI'
            assign card_text = 'مساعدك الذكي لاختيار الإضاءة المثالية لمساحتك'
            assign card_btn_default = 'تحدث الآن'
            assign asset_file = 'enarte-feature-ai.jpg'
            assign flow = 'assistant'
            assign href = assistant_href
          endif

          if card_title == blank
            assign card_title = card_title_default
          endif
          if card_btn == blank
            assign card_btn = card_btn_default
          endif

          if block.settings.button_link != blank and block.settings.button_link != '#' and block.settings.button_link != '#enarte-home-try'
            assign href = block.settings.button_link
          endif
        %}

        <article
          class="enarte-ai-features__card enarte-ai-features__card--{{ style }}"
          data-style="{{ style }}"
          {{ block.shopify_attributes }}
        >
          <div class="enarte-ai-features__body">
            <h3 class="enarte-ai-features__title">{{ card_title }}</h3>
            <p class="enarte-ai-features__text">{{ card_text }}</p>
            <a
              class="enarte-ai-features__btn"
              href="{{ href }}"
              data-enarte-flow="{{ flow }}"
              {% if style == 'ai' %}
                data-enarte-assistant-action="talk_to_assistant"
              {% elsif style == 'search' %}
                data-enarte-image-search
              {% elsif style == 'room' %}
                data-enarte-open-room-try
              {% endif %}
            >
              {{ card_btn }}
            </a>
          </div>

          <div class="enarte-ai-features__media">
            {% if block.settings.image != blank %}
              {{
                block.settings.image
                | image_url: width: 900
                | image_tag:
                  loading: 'lazy',
                  widths: '360,540,720,900',
                  sizes: '(min-width: 990px) 16vw, 46vw',
                  class: 'enarte-ai-features__img',
                  alt: card_title
              }}
            {% else %}
              <img
                class="enarte-ai-features__img"
                src="{{ asset_file | asset_url }}"
                alt="{{ card_title | escape }}"
                width="720"
                height="520"
                loading="lazy"
                decoding="async"
              >
            {% endif %}
          </div>
        </article>
      {% endfor %}
    </div>
  </div>
</section>

<style>
  .enarte-ai-features {
    padding: 3rem 0 3.25rem;
    background: #ffffff;
  }
  .enarte-ai-features__inner {
    max-width: 76rem;
    margin: 0 auto;
    padding: 0 1.25rem;
  }
  .enarte-ai-features__heading {
    margin: 0 0 0.45rem;
    text-align: center;
    font-size: clamp(1.6rem, 2.6vw, 2.1rem);
    font-weight: 700;
    color: #1a1a1a;
    letter-spacing: -0.01em;
  }
  .enarte-ai-features__sub {
    margin: 0 auto 1.75rem;
    max-width: 38rem;
    text-align: center;
    color: rgba(26, 26, 26, 0.62);
    line-height: 1.55;
    font-size: 0.98rem;
  }
  .enarte-ai-features__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.1rem;
    align-items: stretch;
  }

  /* Match approved mockup: text left, illustration right (LTR card shell) */
  .enarte-ai-features__card {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: stretch;
    min-height: 15rem;
    background: #f4f2ee;
    border-radius: 16px;
    overflow: hidden;
    border: 0;
    direction: ltr;
  }
  .enarte-ai-features__media {
    min-height: 15rem;
    background: #ebe6de;
    overflow: hidden;
  }
  .enarte-ai-features__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }
  .enarte-ai-features__body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    gap: 0.55rem;
    padding: 1.35rem 1.2rem 1.4rem;
    text-align: right;
    direction: rtl;
    background: #f4f2ee;
  }
  .enarte-ai-features__title {
    margin: 0;
    font-size: clamp(1.05rem, 1.35vw, 1.22rem);
    font-weight: 700;
    color: #1a1a1a;
    line-height: 1.35;
  }
  .enarte-ai-features__text {
    margin: 0;
    font-size: clamp(0.86rem, 1.05vw, 0.94rem);
    line-height: 1.55;
    color: #3a3a3a;
    font-weight: 400;
  }
  /* Approved CTA: cream fill + gold outline (not a solid dump pill) */
  .enarte-ai-features__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-top: 0.45rem;
    padding: 0.48rem 1.15rem;
    border-radius: 8px;
    border: 1.5px solid #c4a574;
    background: #f7f1e8;
    color: #9a7340 !important;
    text-decoration: none !important;
    font-weight: 700;
    font-size: 0.88rem;
    line-height: 1.2;
    white-space: nowrap;
    box-shadow: none;
    transition: background 0.15s ease, color 0.15s ease, border-color 0.15s ease;
  }
  .enarte-ai-features__btn:hover {
    background: #c4a574;
    border-color: #c4a574;
    color: #ffffff !important;
  }

  /*
    Mobile / tablet ONLY — scaled clone of the desktop reference cards:
    one horizontal swipe row (never stacked). Desktop (≥990px) unchanged.
  */
  @media (max-width: 989px) {
    .enarte-ai-features {
      padding: 2rem 0 2.25rem;
      background: #ffffff;
    }
    .enarte-ai-features__inner {
      padding: 0;
      max-width: none;
    }
    .enarte-ai-features__heading {
      margin: 0 0 0.35rem;
      padding-inline: 16px;
      font-size: 1.45rem;
    }
    .enarte-ai-features__sub {
      margin: 0 0 1.2rem;
      padding-inline: 16px;
      max-width: none;
      font-size: 0.92rem;
    }

    /* Horizontal track — same 3 cards in one row */
    .section-enarte-ai-features .enarte-ai-features__grid,
    .enarte-ai-features__grid {
      display: flex !important;
      flex-flow: row nowrap !important;
      align-items: stretch !important;
      gap: 16px !important;
      overflow-x: auto !important;
      overflow-y: hidden !important;
      -webkit-overflow-scrolling: touch;
      overscroll-behavior-x: contain;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: 16px;
      grid-template-columns: none !important;
      max-width: none !important;
      margin: 0 !important;
      padding: 2px 16px !important;
      scrollbar-width: none;
    }
    .enarte-ai-features__grid::-webkit-scrollbar {
      display: none;
    }

    /*
      Card shell mirrors desktop reference:
      LTR two-column — text/CTA left, illustration right.
      ~300×150 (2:1) preserves the desktop card proportions on a phone.
    */
    .enarte-ai-features__card {
      box-sizing: border-box;
      flex: 0 0 300px !important;
      width: 300px !important;
      max-width: 300px !important;
      height: 150px !important;
      min-height: 150px !important;
      max-height: 150px !important;
      display: grid !important;
      grid-template-columns: 1.2fr 1fr !important;
      grid-template-rows: 1fr !important;
      align-items: stretch !important;
      direction: ltr;
      background: #f4f2ee;
      border-radius: 14px;
      overflow: hidden;
      border: 0;
      scroll-snap-align: start;
      scroll-snap-stop: always;
    }

    .enarte-ai-features__media {
      position: relative;
      min-height: 0 !important;
      height: 100% !important;
      max-height: none !important;
      background: #ebe6de;
      overflow: hidden;
    }
    .enarte-ai-features__img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center right;
      display: block;
    }

    .enarte-ai-features__body {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      justify-content: center;
      gap: 0.35rem;
      padding: 0.85rem 0.8rem 0.9rem 0.75rem;
      text-align: right;
      direction: rtl;
      background: #f4f2ee;
      min-height: 0 !important;
      height: 100%;
      overflow: hidden;
    }
    .enarte-ai-features__title {
      margin: 0;
      font-size: 0.95rem;
      font-weight: 700;
      color: #1a1a1a;
      line-height: 1.3;
      letter-spacing: -0.01em;
    }
    .enarte-ai-features__text {
      margin: 0;
      font-size: 0.74rem;
      line-height: 1.4;
      color: #3a3a3a;
      font-weight: 400;
      display: -webkit-box;
      -webkit-line-clamp: 3;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
    /* Same CTA family as desktop (cream + gold outline), scaled */
    .enarte-ai-features__btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      margin-top: 0.25rem;
      padding: 0.34rem 0.85rem;
      border-radius: 7px;
      border: 1.5px solid #c4a574;
      background: #f7f1e8;
      color: #9a7340 !important;
      font-weight: 700;
      font-size: 0.74rem;
      line-height: 1.2;
      white-space: nowrap;
      min-height: 0;
      box-shadow: none;
    }
  }
</style>

{% schema %}
{
  "name": "ENARTE AI Features",
  "tag": "section",
  "class": "section-enarte-ai-features",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "تجربة ENARTE الذكية"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "تقنيات متقدمة تساعدك على اختيار وتركيب الإضاءة المثالية لمساحتك."
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Card illustration (optional override)" },
        { "type": "text", "id": "title", "label": "Title", "default": "ENARTE AI" },
        {
          "type": "textarea",
          "id": "text",
          "label": "Description",
          "default": "مساعدك الذكي لاختيار الإضاءة المثالية لمساحتك"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "تحدث الآن"
        },
        { "type": "url", "id": "button_link", "label": "Button link override" },
        {
          "type": "select",
          "id": "style",
          "label": "Feature type",
          "options": [
            { "value": "search", "label": "Search by image" },
            { "value": "ai", "label": "Talk to AI" },
            { "value": "room", "label": "Try in room" }
          ],
          "default": "ai"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "ENARTE AI Features",
      "blocks": [
        {
          "type": "feature",
          "settings": {
            "title": "ابحث بالصورة",
            "text": "ارفع صورة أي ثريا ونجد لك ما يناسبها",
            "button_label": "ابحث الآن",
            "style": "search"
          }
        },
        {
          "type": "feature",
          "settings": {
            "title": "ENARTE AI",
            "text": "مساعدك الذكي لاختيار الإضاءة المثالية لمساحتك",
            "button_label": "تحدث الآن",
            "style": "ai"
          }
        },
        {
          "type": "feature",
          "settings": {
            "title": "جرب الإضاءة في غرفتك",
            "text": "شاهد كيف ستبدو الإضاءة في مساحتك باستخدام الذكاء الاصطناعي",
            "button_label": "جرب الآن",
            "style": "room"
          }
        }
      ]
    }
  ]
}
{% endschema %}
