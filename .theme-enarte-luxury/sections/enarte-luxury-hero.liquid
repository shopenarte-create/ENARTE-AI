{% comment %}
  ENARTE luxury hero — full-bleed fade slider (4–5 images).
  Theme Editor images override CDN fallbacks. Presentation only.
{% endcomment %}

{%- liquid
  assign hero_fallback_1 = 'https://images.unsplash.com/photo-1618221195710-dd6b41faaea6?auto=format&fit=crop&w=2400&q=82'
  assign hero_fallback_2 = 'https://images.unsplash.com/photo-1600210492486-724fe5c67fb0?auto=format&fit=crop&w=2400&q=82'
  assign hero_fallback_3 = 'https://images.unsplash.com/photo-1600607687939-ce8a6c25118c?auto=format&fit=crop&w=2400&q=82'
  assign hero_fallback_4 = 'https://images.unsplash.com/photo-1616486338812-3dadae4b4ace?auto=format&fit=crop&w=2400&q=82'
  assign hero_fallback_5 = 'https://images.unsplash.com/photo-1616594039964-ae9021a400a0?auto=format&fit=crop&w=2400&q=82'
-%}

<section
  class="enarte-luxury-hero"
  data-enarte-luxury-hero
  data-interval="{{ section.settings.interval | default: 5000 }}"
  style="--hero-min-height: {{ section.settings.min_height | default: 78 }}vh;"
  aria-roledescription="carousel"
  aria-label="{{ section.settings.heading | escape }}"
>
  <div class="enarte-luxury-hero__media" aria-hidden="true">
    {%- for i in (1..5) -%}
      {%- liquid
        assign picker_key = 'image_' | append: i
        assign picker = section.settings[picker_key]
        case i
          when 1
            assign fallback = hero_fallback_1
          when 2
            assign fallback = hero_fallback_2
          when 3
            assign fallback = hero_fallback_3
          when 4
            assign fallback = hero_fallback_4
          else
            assign fallback = hero_fallback_5
        endcase
      -%}
      <div
        class="enarte-luxury-hero__slide{% if i == 1 %} is-active{% endif %}"
        data-enarte-hero-slide
        data-slide-index="{{ i | minus: 1 }}"
      >
        {%- if picker != blank -%}
          {%- if i == 1 -%}
            {%- assign slide_loading = 'eager' -%}
            {%- assign slide_priority = 'high' -%}
          {%- else -%}
            {%- assign slide_loading = 'lazy' -%}
            {%- assign slide_priority = 'auto' -%}
          {%- endif -%}
          {{
            picker
            | image_url: width: 2400
            | image_tag:
              loading: slide_loading,
              fetchpriority: slide_priority,
              sizes: '100vw',
              widths: '800, 1200, 1600, 2000, 2400',
              class: 'enarte-luxury-hero__img',
              alt: ''
          }}
        {%- else -%}
          <img
            class="enarte-luxury-hero__img"
            src="{{ fallback }}"
            alt=""
            width="2400"
            height="1400"
            {% if i == 1 %}
              loading="eager"
              fetchpriority="high"
            {% else %}
              loading="lazy"
            {% endif %}
            decoding="async"
          >
        {%- endif -%}
      </div>
    {%- endfor -%}
    <div class="enarte-luxury-hero__overlay"></div>
  </div>

  <div class="enarte-luxury-hero__content page-width">
    {%- if section.settings.eyebrow != blank -%}
      <p class="enarte-luxury-hero__eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    <h1 class="enarte-luxury-hero__title enarte-display">{{ section.settings.heading }}</h1>
    {%- if section.settings.subheading != blank -%}
      <p class="enarte-luxury-hero__sub">{{ section.settings.subheading }}</p>
    {%- endif -%}
    {%- if section.settings.button_label != blank or section.settings.show_app_download -%}
      <div class="enarte-luxury-hero__actions">
        {%- if section.settings.button_label != blank -%}
          <a
            class="enarte-btn enarte-btn--gold enarte-luxury-hero__cta"
            href="{{ section.settings.button_link | default: routes.all_products_collection_url }}"
          >
            {{ section.settings.button_label }}
          </a>
        {%- endif -%}
        {%- if section.settings.show_app_download -%}
          {% render 'enarte-app-download',
            variant: 'hero',
            label: section.settings.app_download_label
          %}
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>

  <div class="enarte-luxury-hero__controls">
    <button
      type="button"
      class="enarte-luxury-hero__nav enarte-luxury-hero__nav--prev"
      data-enarte-hero-prev
      aria-label="السابق"
    >
      <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6">
        <path d="M15 5l-7 7 7 7" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>
    <button
      type="button"
      class="enarte-luxury-hero__nav enarte-luxury-hero__nav--next"
      data-enarte-hero-next
      aria-label="التالي"
    >
      <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6">
        <path d="M9 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>
  </div>

  <div class="enarte-luxury-hero__dots" data-enarte-hero-dots role="tablist" aria-label="شرائح البطل">
    {%- for i in (1..5) -%}
      <button
        type="button"
        class="enarte-luxury-hero__dot{% if i == 1 %} is-active{% endif %}"
        data-enarte-hero-dot="{{ i | minus: 1 }}"
        aria-label="الشريحة {{ i }}"
        aria-selected="{% if i == 1 %}true{% else %}false{% endif %}"
      ></button>
    {%- endfor -%}
  </div>
</section>

{% stylesheet %}
  .enarte-luxury-hero {
    position: relative;
    min-height: var(--hero-min-height, 78vh);
    display: grid;
    align-items: end;
    overflow: hidden;
    color: #fff;
    isolation: isolate;
    background: #1c1914;
  }

  .enarte-luxury-hero__media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .enarte-luxury-hero__slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 1.4s cubic-bezier(0.4, 0, 0.2, 1);
    pointer-events: none;
  }

  .enarte-luxury-hero__slide.is-active {
    opacity: 1;
    z-index: 1;
  }

  .enarte-luxury-hero__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transform: scale(1.04);
    transition: transform 7s ease-out;
  }

  .enarte-luxury-hero__slide.is-active .enarte-luxury-hero__img {
    transform: scale(1);
  }

  .enarte-luxury-hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(18, 16, 12, 0.78) 0%,
      rgba(18, 16, 12, 0.32) 42%,
      rgba(18, 16, 12, 0.18) 100%
    );
    z-index: 2;
  }

  .enarte-luxury-hero__content {
    position: relative;
    z-index: 3;
    padding: 4.5rem 1.25rem 4.75rem;
    max-width: 44rem;
    text-align: start;
  }

  [dir='rtl'] .enarte-luxury-hero__content {
    margin-inline-start: auto;
  }

  .enarte-luxury-hero__eyebrow {
    margin: 0 0 0.75rem;
    font-size: 0.82rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.78);
  }

  .enarte-luxury-hero__title {
    margin: 0;
    font-size: clamp(2.35rem, 5vw, 4.25rem);
    line-height: 1.12;
    color: #fff !important;
    text-wrap: balance;
  }

  .enarte-luxury-hero__sub {
    margin: 1rem 0 0;
    max-width: 34rem;
    font-size: 1.05rem;
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.88);
  }

  .enarte-luxury-hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    margin-top: 1.6rem;
  }

  .enarte-luxury-hero__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-top: 0;
    padding: 0.95rem 1.75rem;
    text-decoration: none;
    min-width: 9.5rem;
  }

  .enarte-luxury-hero__controls {
    position: absolute;
    inset-inline: 0.75rem;
    top: 50%;
    transform: translateY(-50%);
    z-index: 4;
    display: flex;
    justify-content: space-between;
    pointer-events: none;
  }

  .enarte-luxury-hero__nav {
    pointer-events: auto;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.35);
    background: rgba(18, 16, 12, 0.28);
    color: #fff;
    display: grid;
    place-items: center;
    cursor: pointer;
    backdrop-filter: blur(8px);
    transition: background 0.25s ease, border-color 0.25s ease, transform 0.2s ease;
  }

  .enarte-luxury-hero__nav:hover {
    background: rgba(196, 163, 90, 0.85);
    border-color: rgba(196, 163, 90, 0.95);
    color: #1c1914;
    transform: scale(1.04);
  }

  .enarte-luxury-hero__dots {
    position: absolute;
    inset-inline: 0;
    bottom: 1.35rem;
    z-index: 4;
    display: flex;
    justify-content: center;
    gap: 0.55rem;
  }

  .enarte-luxury-hero__dot {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 999px;
    border: none;
    padding: 0;
    background: rgba(255, 255, 255, 0.42);
    cursor: pointer;
    transition: width 0.3s ease, background 0.3s ease;
  }

  .enarte-luxury-hero__dot.is-active {
    width: 1.55rem;
    background: #c4a35a;
  }

  @media (max-width: 749px) {
    .enarte-luxury-hero {
      min-height: 70vh;
    }
    .enarte-luxury-hero__content {
      padding: 3rem 1rem 4.25rem;
    }
    .enarte-luxury-hero__nav {
      width: 2.35rem;
      height: 2.35rem;
    }
    .enarte-luxury-hero__controls {
      inset-inline: 0.4rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .enarte-luxury-hero__slide,
    .enarte-luxury-hero__img {
      transition: none !important;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "ENARTE Luxury Hero",
  "tag": "section",
  "class": "section-enarte-luxury-hero",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "ENARTE LIGHTING"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "حيث تلتقي الإضاءة بالفخامة والجمال"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "مجموعات حصرية من الثريات والإضاءة الفاخرة لمساحات تعكس ذوقك."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "تسوق الآن"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "checkbox",
      "id": "show_app_download",
      "label": "Show app download button",
      "default": true
    },
    {
      "type": "text",
      "id": "app_download_label",
      "label": "App download label",
      "default": "حمّل التطبيق"
    },
    {
      "type": "range",
      "id": "interval",
      "label": "Slide interval (ms)",
      "min": 3000,
      "max": 9000,
      "step": 500,
      "default": 5000
    },
    {
      "type": "range",
      "id": "min_height",
      "label": "Min height (vh)",
      "min": 55,
      "max": 95,
      "step": 1,
      "default": 78
    },
    {
      "type": "header",
      "content": "Images (optional overrides)"
    },
    { "type": "image_picker", "id": "image_1", "label": "Hero image 1" },
    { "type": "image_picker", "id": "image_2", "label": "Hero image 2" },
    { "type": "image_picker", "id": "image_3", "label": "Hero image 3" },
    { "type": "image_picker", "id": "image_4", "label": "Hero image 4" },
    { "type": "image_picker", "id": "image_5", "label": "Hero image 5" }
  ],
  "presets": [{ "name": "ENARTE Luxury Hero" }]
}
{% endschema %}
