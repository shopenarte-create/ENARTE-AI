{% comment %}
  Footer / page strip: ENARTE mobile app download.
{% endcomment %}

{%- if section.settings.enable -%}
  <section class="enarte-app-bar" {{ section.shopify_attributes }}>
    <div class="enarte-app-bar__inner page-width">
      {%- if section.settings.heading != blank -%}
        <p class="enarte-app-bar__heading">{{ section.settings.heading }}</p>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <p class="enarte-app-bar__text">{{ section.settings.text }}</p>
      {%- endif -%}
      {% render 'enarte-app-download',
        variant: 'footer',
        label: section.settings.button_label
      %}
    </div>
  </section>
{%- endif -%}

{% stylesheet %}
  .enarte-app-bar {
    background: linear-gradient(180deg, #1a1713 0%, #12100c 100%);
    color: #f7f3ec;
    padding: 1.75rem 1rem;
    border-top: 1px solid rgba(196, 163, 90, 0.28);
  }

  .enarte-app-bar__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.55rem;
  }

  .enarte-app-bar__heading {
    margin: 0;
    font-size: 1.15rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: #c4a35a;
  }

  .enarte-app-bar__text {
    margin: 0 0 0.35rem;
    max-width: 34rem;
    font-size: 0.95rem;
    line-height: 1.6;
    color: rgba(247, 243, 236, 0.82);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "ENARTE App Download",
  "tag": "section",
  "class": "section-enarte-app-download",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable",
      "label": "Show app download bar",
      "default": true
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "تطبيق ENARTE"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Supporting text",
      "default": "تسوّق وجرّب الإضاءة في غرفتك من هاتفك — حمّل التطبيق الآن."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "حمّل التطبيق"
    }
  ],
  "presets": [{ "name": "ENARTE App Download" }]
}
{% endschema %}
