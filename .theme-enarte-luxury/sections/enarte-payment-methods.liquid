{% comment %}
  ENARTE payment methods strip — UI ready for Visa/Mastercard, CliQ, COD.
  Actual payment gateway enablement is done in Shopify Admin (Payments).
{% endcomment %}

<section class="enarte-payments" aria-label="{{ section.settings.heading | escape }}">
  <div class="page-width enarte-payments__inner">
    {% if section.settings.heading != blank %}
      <p class="enarte-payments__heading">{{ section.settings.heading }}</p>
    {% endif %}
    <ul class="enarte-payments__list" role="list">
      {% for block in section.blocks %}
        <li class="enarte-payments__item" {{ block.shopify_attributes }}>
          <span class="enarte-payments__badge enarte-payments__badge--{{ block.settings.method }}" aria-hidden="true">
            {%- case block.settings.method -%}
              {%- when 'visa' -%}
                <svg viewBox="0 0 48 32" width="40" height="26" fill="none"><rect width="48" height="32" rx="6" fill="#1a1f71"/><text x="24" y="20" text-anchor="middle" fill="#fff" font-size="11" font-family="Arial,sans-serif" font-weight="700">VISA</text></svg>
              {%- when 'mastercard' -%}
                <svg viewBox="0 0 48 32" width="40" height="26" fill="none"><rect width="48" height="32" rx="6" fill="#2a2a2a"/><circle cx="19" cy="16" r="8" fill="#eb001b"/><circle cx="29" cy="16" r="8" fill="#f79e1b"/><path d="M24 9.5a8 8 0 010 13 8 8 0 000-13z" fill="#ff5f00"/></svg>
              {%- when 'cliq' -%}
                <svg viewBox="0 0 48 32" width="40" height="26" fill="none"><rect width="48" height="32" rx="6" fill="#0b6e4f"/><text x="24" y="20" text-anchor="middle" fill="#fff" font-size="10" font-family="Arial,sans-serif" font-weight="700">Click</text></svg>
              {%- else -%}
                <svg viewBox="0 0 48 32" width="40" height="26" fill="none"><rect width="48" height="32" rx="6" fill="#c4a35a"/><path d="M14 18h20M16 14h4M28 14h4" stroke="#1c1914" stroke-width="1.6" stroke-linecap="round"/></svg>
            {%- endcase -%}
          </span>
          <span class="enarte-payments__label">{{ block.settings.label }}</span>
        </li>
      {% endfor %}
    </ul>
  </div>
</section>

{% stylesheet %}
  .enarte-payments {
    background: #15130f;
    border-top: 1px solid #2e2a24;
    padding: 1.15rem 0 1.35rem;
    color: rgba(247, 243, 236, 0.86);
  }

  .enarte-payments__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.85rem 1.5rem;
  }

  .enarte-payments__heading {
    margin: 0;
    font-size: 0.82rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(247, 243, 236, 0.62);
  }

  .enarte-payments__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem 1rem;
    align-items: center;
  }

  .enarte-payments__item {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }

  .enarte-payments__badge {
    display: inline-flex;
    line-height: 0;
  }

  .enarte-payments__label {
    font-size: 0.86rem;
    color: rgba(247, 243, 236, 0.88);
  }

  @media (max-width: 749px) {
    .enarte-payments__inner {
      flex-direction: column;
      align-items: stretch;
      text-align: center;
    }
    .enarte-payments__list {
      justify-content: center;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "ENARTE Payment Methods",
  "tag": "section",
  "class": "section-enarte-payments",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "طرق الدفع المتاحة"
    }
  ],
  "blocks": [
    {
      "type": "method",
      "name": "Payment method",
      "settings": [
        {
          "type": "select",
          "id": "method",
          "label": "Method",
          "default": "visa",
          "options": [
            { "value": "visa", "label": "Visa" },
            { "value": "mastercard", "label": "Mastercard" },
            { "value": "cliq", "label": "CliQ" },
            { "value": "cod", "label": "Cash on Delivery" }
          ]
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Visa"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "ENARTE Payment Methods",
      "blocks": [
        { "type": "method", "settings": { "method": "visa", "label": "Visa" } },
        { "type": "method", "settings": { "method": "mastercard", "label": "Mastercard" } },
        { "type": "method", "settings": { "method": "cliq", "label": "CliQ" } },
        { "type": "method", "settings": { "method": "cod", "label": "الدفع عند الاستلام" } }
      ]
    }
  ]
}
{% endschema %}
