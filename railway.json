{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile"
  },
  "deploy": {
    "startCommand": "npm run docker-start",
    "healthcheckPath": "/api/try-handoff?id=ping",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 8
  }
}
