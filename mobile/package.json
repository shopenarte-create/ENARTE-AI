{
  "name": "enarte-mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~54.0.35",
    "expo-auth-session": "~7.0.11",
    "expo-constants": "~18.0.13",
    "expo-crypto": "~15.0.9",
    "expo-file-system": "~19.0.21",
    "expo-font": "~14.0.12",
    "expo-image": "~3.0.11",
    "expo-image-picker": "~17.0.10",
    "expo-linking": "~8.0.12",
    "expo-notifications": "~0.32.17",
    "expo-router": "~6.0.24",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-symbols": "~1.0.8",
    "expo-web-browser": "~15.0.11",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.15.0",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@expo/ngrok": "^4.1.3",
    "@types/react": "~19.1.0",
    "typescript": "~5.9.2"
  },
  "scripts": {
    "start": "node --no-experimental-strip-types ./node_modules/expo/bin/cli start",
    "start:clear": "node --no-experimental-strip-types ./node_modules/expo/bin/cli start -c",
    "android": "node --no-experimental-strip-types ./node_modules/expo/bin/cli start --android",
    "ios": "node --no-experimental-strip-types ./node_modules/expo/bin/cli start --ios",
    "web": "node --no-experimental-strip-types ./node_modules/expo/bin/cli start --web",
    "typecheck": "tsc --noEmit",
    "export:web": "node --no-experimental-strip-types ./node_modules/expo/bin/cli export -p web --output-dir dist",
    "eas:preview:android": "npx eas-cli build --platform android --profile preview",
    "eas:preview:ios": "npx eas-cli build --platform ios --profile preview"
  },
  "private": true
}
