{
  "expo": {
    "name": "ENARTE",
    "slug": "enarte-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "enarte",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.enarte.mobile",
      "infoPlist": {
        "NSCameraUsageDescription": "نستخدم الكاميرا لتجربة الإضاءة في غرفتك.",
        "NSPhotoLibraryUsageDescription": "نحتاج الوصول للصور لرفع صورة الغرفة أو البحث بالصورة."
      }
    },
    "android": {
      "package": "com.enarte.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#f7f3ec",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#f7f3ec"
        }
      ],
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "نحتاج الوصول للصور لرفع صورة الغرفة أو البحث بالصورة.",
          "cameraPermission": "نستخدم الكاميرا لتجربة الإضاءة في غرفتك."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
