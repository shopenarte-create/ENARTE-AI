// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean?
  locale              String?
  collaborator        Boolean?
  emailVerified       Boolean?
  refreshToken        String?
  refreshTokenExpires DateTime?

  @@map("session")
}

/// Durable room-image handoff (storefront → /try). Survives restarts & multi-instance.
model TryHandoff {
  id          String   @id
  mimeType    String
  image       Bytes
  productJson String?
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  @@index([expiresAt])
  @@map("try_handoff")
}

/// ENARTE AI Assistant — conversation container (shop-scoped).
/// Foundation only: no business payloads required in Phase 1.
model AssistantConversation {
  id        String   @id @default(cuid())
  shop      String
  channel   String   @default("api")
  locale    String   @default("ar")
  status    String   @default("active")
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages AssistantMessage[]
  events   AssistantEvent[]

  @@index([shop, status])
  @@index([shop, createdAt])
  @@map("assistant_conversation")
}

model AssistantMessage {
  id             String   @id @default(cuid())
  conversationId String
  role           String
  content        String   @default("")
  workflowId     String?
  metadata       Json?
  createdAt      DateTime @default(now())

  conversation AssistantConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("assistant_message")
}

/// Structured events for analytics, learning, and external module hooks.
model AssistantEvent {
  id             String   @id @default(cuid())
  shop           String
  conversationId String?
  type           String
  payload        Json?
  createdAt      DateTime @default(now())

  conversation AssistantConversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([shop, type, createdAt])
  @@index([conversationId, createdAt])
  @@map("assistant_event")
}

/// Human-approved Q&A taught via conversation training mode.
/// When a matching question appears later, this answer is preferred over the LLM.
model AssistantTaughtAnswer {
  id             String   @id @default(cuid())
  shop           String
  locale         String   @default("ar")
  question       String
  questionNorm   String
  answer         String
  status         String   @default("approved")
  conversationId String?
  sourceMessageId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([shop, questionNorm])
  @@index([shop, locale, status])
  @@index([shop, updatedAt])
  @@map("assistant_taught_answer")
}